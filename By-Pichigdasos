module2.integrityDisconnect = function()
    local integrity = module2.Integrity

    for i = 1, #integrity.connections do
        local v = integrity.connections[i]

        if v then
            pcall(function()
                v:Disconnect()
            end)
        end
    end

    table.clear(integrity.connections)

    pcall(function()
        RunService:UnbindFromRenderStep(integrity.guardName)
    end)
end

module2.integrityEscalate = function()
    local integrity = module2.Integrity
    local now = os.clock()

    if now - integrity.tamperWindow > 0.45 then
        integrity.tamperWindow = now
        integrity.tamperCount = 0
    end

    integrity.tamperCount = integrity.tamperCount + 1

    if integrity.tamperCount >= 3 then
        integrity.hardUntil = math.max(integrity.hardUntil, now + 2.5)
    end
end

module2.integrityRepairRecord = function(child2, list)
    local instance = child2 and child2.instance
    if not instance then
        return
    end

    if child2.parent and instance.Parent ~= child2.parent then
        pcall(function()
            instance.Parent = child2.parent
        end)
    end

    if list then
        local v = child2.properties[list]

        if v ~= nil then
            local ok, result = pcall(function()
                return instance[list]
            end)

            if ok and result ~= v then
                pcall(function()
                    instance[list] = v
                end)
            end
        end

        return
    end

    for k, property in pairs(child2.properties) do
        local ok, result = pcall(function()
            return instance[k]
        end)

        if ok and result ~= property then
            pcall(function()
                instance[k] = property
            end)
        end
    end
end

module2.integrityQueueRepair = function()
    local integrity = module2.Integrity
    if not integrity.armed or integrity.restoring or integrity.repairQueued then
        return
    end
    integrity.repairQueued = true

    task.defer(function()
        integrity.repairQueued = false
        module2.integrityRepairAll()
    end)
end

module2.integrityRepairAll = function()
    local integrity = module2.Integrity
    if not integrity.armed or integrity.restoring then
        return
    end
    integrity.restoring = true

    for i = 1, #integrity.records do
        module2.integrityRepairRecord(integrity.records[i])
    end

    if integrity.refresh then
        pcall(integrity.refresh)
    end

    integrity.restoring = false
end

module2.integrityWatch = function(child2, list, parent)
    if not child2 then
        return
    end
    local integrity = module2.Integrity
    local constants = { instance = child2, properties = list, parent = parent }
    integrity.records[#integrity.records + 1] = constants

    if parent then
        integrity.connections[#integrity.connections + 1] = child2.AncestryChanged:Connect(function()
            if not integrity.armed or integrity.restoring or child2.Parent == parent then
                return
            end
            module2.integrityEscalate()
            integrity.restoring = true

            pcall(function()
                child2.Parent = parent
            end)

            integrity.restoring = false

            if child2.Parent ~= parent then
                module2.integrityQueueRepair()
            end
        end)
    end

    integrity.connections[#integrity.connections + 1] = child2.Changed:Connect(function(arg1)
        if not integrity.armed or integrity.restoring or list[arg1] == nil then
            return
        end

        local ok, result = pcall(function()
            return child2[arg1]
        end)

        if ok and result == list[arg1] then
            return
        end
        module2.integrityEscalate()
        integrity.restoring = true
        module2.integrityRepairRecord(constants, arg1)
        integrity.restoring = false
    end)
end

module2.integrityWatchComputed = function(child2, list, arg1)
    if not child2 or not arg1 then
        return
    end
    local integrity = module2.Integrity
    local constants = {}

    for i = 1, #list do
        constants[list[i]] = true
    end

    integrity.connections[#integrity.connections + 1] = child2.Changed:Connect(function(arg1_2)
        if not integrity.armed or integrity.restoring or not constants[arg1_2] then
            return
        end
        module2.integrityEscalate()
        integrity.restoring = true
        pcall(arg1)
        integrity.restoring = false
    end)
end

module2.armHubIntegrity = function(child2)
    local integrity = module2.Integrity
    module2.integrityDisconnect()
    integrity.armed = false
    integrity.restoring = false
    integrity.repairQueued = false
    integrity.records = {}
    integrity.knownRootChildren = {}
    integrity.hardUntil = 0
    integrity.hardRefreshAt = 0
    integrity.tamperCount = 0
    integrity.tamperWindow = os.clock()
    local gui = child2.gui
    if not gui or not gui.Parent then
        return
    end
    local dynamicText = child2.dynamicText or {}
    local dynamicTextColor = child2.dynamicTextColor or {}
    local dynamicTextTransparency = child2.dynamicTextTransparency or {}
    local dynamicBackground = child2.dynamicBackground or {}
    local dynamicBackgroundTransparency = child2.dynamicBackgroundTransparency or {}
    local dynamicSize = child2.dynamicSize or {}
    local dynamicPosition = child2.dynamicPosition or {}
    local dynamicRotation = child2.dynamicRotation or {}
    local dynamicStrokeColor = child2.dynamicStrokeColor or {}
    local dynamicStrokeTransparency = child2.dynamicStrokeTransparency or {}

    local function create(list)
        local constants = { Name = list.Name }

        if list:IsA("ScreenGui") then
            constants.ResetOnSpawn = list.ResetOnSpawn
            constants.IgnoreGuiInset = list.IgnoreGuiInset
            constants.DisplayOrder = list.DisplayOrder
            constants.AutoLocalize = list.AutoLocalize
            constants.ZIndexBehavior = list.ZIndexBehavior
        end

        if list:IsA("GuiObject") then
            constants.BorderSizePixel = list.BorderSizePixel
            constants.ZIndex = list.ZIndex
            constants.AnchorPoint = list.AnchorPoint

            if not dynamicSize[list] then
                constants.Size = list.Size
            end

            if not dynamicPosition[list] then
                constants.Position = list.Position
            end

            if not dynamicRotation[list] then
                constants.Rotation = list.Rotation
            end

            if not dynamicBackground[list] then
                constants.BackgroundColor3 = list.BackgroundColor3
            end

            if not dynamicBackgroundTransparency[list] then
                constants.BackgroundTransparency = list.BackgroundTransparency
            end
        end

        if list:IsA("TextLabel") or list:IsA("TextButton") then
            if not dynamicText[list] then
                constants.Text = list.Text
            end

            if not dynamicTextColor[list] then
                constants.TextColor3 = list.TextColor3
            end

            if not dynamicTextTransparency[list] then
                constants.TextTransparency = list.TextTransparency
            end

            constants.TextStrokeColor3 = list.TextStrokeColor3
            constants.TextStrokeTransparency = list.TextStrokeTransparency
            constants.TextSize = list.TextSize
            constants.Font = list.Font
            constants.TextXAlignment = list.TextXAlignment
            constants.TextYAlignment = list.TextYAlignment
            constants.TextWrapped = list.TextWrapped
            constants.TextScaled = list.TextScaled
            constants.TextTruncate = list.TextTruncate

            if list:IsA("TextButton") then
                constants.AutoButtonColor = list.AutoButtonColor
            end
        end

        if list:IsA("ImageLabel") or list:IsA("ImageButton") then
            constants.Image = list.Image
            constants.ImageColor3 = list.ImageColor3
            constants.ImageTransparency = list.ImageTransparency
            constants.ScaleType = list.ScaleType

            if list:IsA("ImageButton") then
                constants.AutoButtonColor = list.AutoButtonColor
            end
        end

        if list:IsA("UIStroke") then
            if not dynamicStrokeColor[list] then
                constants.Color = list.Color
            end

            if not dynamicStrokeTransparency[list] then
                constants.Transparency = list.Transparency
            end

            constants.Thickness = list.Thickness
            constants.LineJoinMode = list.LineJoinMode
        end

        if list:IsA("UICorner") then
            constants.CornerRadius = list.CornerRadius
        end

        if list:IsA("UIScale") then
            constants.Scale = list.Scale
        end

        if list:IsA("UIGradient") then
            constants.Color = list.Color
            constants.Transparency = list.Transparency
            constants.Rotation = list.Rotation
        end

        return constants
    end

    local parent = gui.Parent
    module2.integrityWatch(gui, create(gui), parent)
    local children = gui:GetChildren()

    for i = 1, #children do
        integrity.knownRootChildren[children[i]] = true
    end

    module2.walk(gui, function(list)
        local parent2 = list.Parent
        module2.integrityWatch(list, create(list), parent2)
    end)

    integrity.connections[#integrity.connections + 1] = gui.ChildAdded:Connect(function(child)
        if not integrity.armed or integrity.restoring then
            return
        end

        if not integrity.knownRootChildren[child] then
            module2.integrityEscalate()

            pcall(function()
                child:Destroy()
            end)
        end
    end)

    integrity.connections[#integrity.connections + 1] = gui.ChildRemoved:Connect(function(child)
        if not integrity.armed or integrity.restoring or not integrity.knownRootChildren[child] then
            return
        end
        module2.integrityEscalate()
        module2.integrityQueueRepair()
    end)

    local computed = child2.computed or {}

    for i = 1, #computed do
        local v = child2.computed[i]
        module2.integrityWatchComputed(v.instance, v.properties, v.repair)
    end

    integrity.refresh = child2.refresh
    integrity.armed = true
    module2.integrityRepairAll()

    pcall(function()
        RunService:UnbindFromRenderStep(integrity.guardName)
    end)

    RunService:BindToRenderStep(integrity.guardName, Enum.RenderPriority.Last.Value + 1000, function()
        local now = os.clock()
        if not integrity.armed or integrity.restoring or now > integrity.hardUntil then
            return
        end
        integrity.restoring = true

        for i = 1, #integrity.records do
            module2.integrityRepairRecord(integrity.records[i])
        end

        if integrity.refresh and now >= integrity.hardRefreshAt then
            integrity.hardRefreshAt = now + 0.05
            pcall(integrity.refresh)
        end

        integrity.restoring = false
    end)
end

