module2.getGroundAdjustedPosition = function(child2)
    if typeof(child2) ~= "Vector3" then
        return child2
    end
    local n = tonumber(constants.GROUND_CLEARANCE) or 4
    local character = localPlayer.Character or v
    local humanoidRootPart2 = character and character:FindFirstChild("HumanoidRootPart")
    character = character and character:FindFirstChildOfClass("Humanoid")
    local size2

    if humanoidRootPart2 and character then
        size2 = math.max(n, humanoidRootPart2.Size.Y * 0.5 + math.max(tonumber(character.HipHeight) or 0, 0) + 0.2)
    else
        size2 = n
    end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local filterDescendantsInstances = {}

    if v and v.Parent then
        table.insert(filterDescendantsInstances, v)
    end

    local size3 = child2 + Vector3.new(0, constants.RAYCAST_UP, 0)
    local vector = Vector3.new(0, -(constants.RAYCAST_UP + constants.RAYCAST_DOWN), 0)

    for i = 1, 8 do
        raycastParams.FilterDescendantsInstances = filterDescendantsInstances
        local hit = workspace:Raycast(size3, vector, raycastParams)
        if not hit then
            return child2
        end
        local instance = hit.Instance
        if instance:IsA("Terrain") or instance:IsA("BasePart") and instance.CanCollide then
            return Vector3.new(child2.X, hit.Position.Y + size2, child2.Z)
        end
        table.insert(filterDescendantsInstances, instance)
    end

    return child2
end

module2.liftCharacterOutOfGround = function()
    local character = localPlayer.Character or v
    local humanoidRootPart2 = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid2 = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoidRootPart2 or not humanoid2 then
        return
    end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local filterDescendantsInstances = { character }
    local object4 = nil

    for i = 1, 8 do
        raycastParams.FilterDescendantsInstances = filterDescendantsInstances
        local hit = workspace:Raycast(humanoidRootPart2.Position + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), raycastParams)
        object4 = nil

        if hit then
            local instance = hit.Instance

            if instance:IsA("Terrain") or instance:IsA("BasePart") and instance.CanCollide then
                object4 = hit
                break
            else
                table.insert(filterDescendantsInstances, instance)
                object4 = nil
                continue
            end
        end

        break
    end

    if not object4 then
        return
    end

    if humanoidRootPart2.Position.Y + 1.5 < object4.Position.Y then
        return
    end
    local n = object4.Position.Y + humanoidRootPart2.Size.Y * 0.5 + math.max(tonumber(humanoid2.HipHeight) or 0, 0) + 0.2

    if humanoidRootPart2.Position.Y < n - 0.05 then
        humanoidRootPart2.AssemblyLinearVelocity = Vector3.zero
        humanoidRootPart2.AssemblyAngularVelocity = Vector3.zero
        humanoidRootPart2.CFrame = humanoidRootPart2.CFrame + Vector3.new(0, n - humanoidRootPart2.Position.Y, 0)
    end
end

