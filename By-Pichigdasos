module2 = {
    walk = function(child2, list)
        if not child2 or not list then
            return nil
        end
        local children = child2:GetChildren()

        while #children > 0 do
            local n = #children
            local v = children[n]
            children[n] = nil
            local children2 = v:GetChildren()

            for i = 1, #children2 do
                children[#children + 1] = children2[i]
            end

            if list(v) ~= true then
                continue
            end
            return v
        end

        return nil
    end,
    snapshot = function(child2)
        local constants = {}

        module2.walk(child2, function(list)
            constants[#constants + 1] = list
        end)

        return constants
    end,
}

